# How the abilities, the health bars and the HUD look and are laid out. Presentation only: nothing here changes what
# happens, and it is not saved or hashed. Debug builds reload it within half a second of an edit, so a number can be tuned
# with the game running; a key left out keeps its shipped number, and a value out of range is refused with its line (the old
# look stays).
#
# abilities: how each ability's sword, bolt or burst is drawn. fire_bolt and flying_swords take
#   sword_scale (how much larger than its image the blade is drawn, above 0); trail (seconds the trail reaches back, above
#   0), trail_width (world units at the sword, above 0), trail_taper (how much of that width its tail loses, 0 to 1) and
#   trail_intensity (the trail's brightness as a fraction of its element's colour, 0 or more). Each blade's glow is its
#   role's below (glow_roles: flying_swords, fire_bolt).
#   poison_lance takes flash_start_scale and flash_end_scale (its burst's size as a multiple of its 96-unit sprite at its
#   start and end, above 0) and flash_intensity (its brightness, 0 or more).
# health_bar: an enemy's bar in world units: rise (how far over its head the bar's middle sits, 0 or more), width and height
#   (the background, above 0), fill_width (the fill at full health) and fill_height (above 0).
# hud: the temporary HUD in target pixels at text scale 1: margin (in from the left and bottom edges, 0 or more), bar_width,
#   bar_height, line_height (slot to slot, above 0), bar_gap, bar_text_inset, bar_text_rise (0 or more), not_enough_qi
#   (seconds the Qi bar warns after a refused cast, above 0) and cooling_ink_opacity (a cooling slot's ink, 0 to 1).
abilities:
  fire_bolt:     { sword_scale: 1.0, trail: 0.1, trail_width: 5, trail_taper: 0.6, trail_intensity: 1 }
  flying_swords: { sword_scale: 0.9, trail: 0.1, trail_width: 5, trail_taper: 0.6, trail_intensity: 1 }
  poison_lance:  { flash_start_scale: 0.5, flash_end_scale: 1.9, flash_intensity: 1 }
health_bar: { rise: 5, width: 44, height: 6, fill_width: 40, fill_height: 4 }
hud: { margin: 16, bar_width: 240, bar_height: 18, line_height: 24, bar_gap: 6, bar_text_inset: 6, bar_text_rise: 7,
       not_enough_qi: 1, cooling_ink_opacity: 0.55 }
# glows: named looks of the light or ink a sprite wears round its edge. Each takes colour (a palette colour as area.key, such as
#   selection.selected or effects.damage, or `element`: the ability's element colour; never hex), blend (`light` adds light,
#   best on dark ground; `ink` paints over, which reads on the pale paper), size (texels it reaches past the edge at zoom 1,
#   above 0, at most 16), feather (0 a hard ring, 1 a soft fade from the edge), opacity (its strength at full drive, 0 to 1),
#   zoom_shrink (0 grows with the sprite as the camera zooms in, 1 keeps its width on screen) and drive, what moves it:
#   { kind: steady } is always full; { kind: pulse, period (seconds a beat, at least 1/3), depth (how far it dips, 0 to 1),
#   curve }; { kind: charge, curve, fade (seconds to fade after release, above 0), fade_curve } follows the game's value;
#   { kind: progress, curve, results: [up to 8 palette colours] } follows the value, then shows a result's colour. Curves:
#   linear, ease_in, ease_out, smooth, sine. A key left out keeps its value: a glow named like a shipped one below changes only
#   the keys it gives; a new name starts from the sword aura's look without its pulse, steady.
# glow_roles: the glow each role of the code wears: selected, hover, flying_swords, fire_bolt, demo_pulse, demo_charge and
#   demo_progress, all of them or none; each names a glow above.
glows:
  sword_aura:    { colour: element, blend: light, size: 8.5, feather: 0.75, opacity: 0.15, zoom_shrink: 0.6,
                   drive: { kind: pulse, period: 1.6, depth: 0.9, curve: sine } }
  bolt_aura:     { colour: element, blend: light, size: 8.5, feather: 0.75, opacity: 0.15, zoom_shrink: 0.6,
                   drive: { kind: pulse, period: 1.6, depth: 0.9, curve: sine } }
  selected:      { colour: selection.selected, blend: ink, size: 3, feather: 0, opacity: 1, zoom_shrink: 0,
                   drive: { kind: steady } }
  hover:         { colour: selection.hover, blend: ink, size: 3, feather: 0, opacity: 1, zoom_shrink: 0,
                   drive: { kind: steady } }
  demo_pulse:    { colour: effects.damage, blend: ink, size: 8.5, feather: 0.75, opacity: 0.6, zoom_shrink: 0.6,
                   drive: { kind: pulse, period: 1.6, depth: 0.9, curve: sine } }
  demo_charge:   { colour: effects.burn, blend: ink, size: 10, feather: 0.8, opacity: 0.7, zoom_shrink: 0.6,
                   drive: { kind: charge, curve: ease_in, fade: 0.4, fade_curve: ease_out } }
  demo_progress: { colour: names_and_captions.caption, blend: ink, size: 10, feather: 0.8, opacity: 0.7, zoom_shrink: 0.6,
                   drive: { kind: progress, curve: linear,
                            results: [effects.healing, effects.damage, effects.poison, effects.burn] } }
glow_roles: { selected: selected, hover: hover, flying_swords: sword_aura, fire_bolt: bolt_aura, demo_pulse: demo_pulse,
              demo_charge: demo_charge, demo_progress: demo_progress }

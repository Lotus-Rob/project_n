# Local environments and tool state
# Worktrees: superpowers' fallback folder and Claude Code's own
.worktrees/
.claude/worktrees/
# superpowers' brainstorm companion: mockups and screenshots per session, scratch once the decision is written down
.superpowers/brainstorm/
.pixi/
.xmake/
.cache/
.ruff_cache/
.vs/
.DS_Store
# Per-developer spell-checker dictionary (typos-lsp)
typos.toml
# Claude Code's per-developer settings
.claude/settings.local.json

# Secrets: environment files and keys never belong in the repo
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Build outputs
build/
dist/

# Logs: the game writes its own to the per-user data folder, never here (src/AGENTS.md)
logs/
*.log

# Python bytecode (tools/)
__pycache__/

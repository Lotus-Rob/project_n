# API reference (`project_n docs`): Doxygen's defaults except these. project_n runs it from the
# repository root, so paths are relative to it.
PROJECT_NAME          = "Project N"
OUTPUT_DIRECTORY      = build/docs
# Each module (design doc 0002 §4) defines its group in src/<module>/module.dox, and each header's
# file comment joins it with @ingroup, so the reference is grouped by module.
INPUT                 = src
RECURSIVE             = YES
# Headers only: they carry the API documentation; .cpp comments explain why, not what.
FILE_PATTERNS         = *.hpp *.dox
EXCLUDE_PATTERNS      = */pch.hpp
STRIP_FROM_PATH       = src
STRIP_FROM_INC_PATH   = src
GENERATE_LATEX        = NO
QUIET                 = YES
# An undocumented public class, function or member, or a broken doc comment, fails the run (and
# `lint`, which runs this over the changed headers). Private members and anonymous namespaces are
# Doxygen's defaults to skip.
WARN_IF_UNDOCUMENTED  = YES
WARN_AS_ERROR         = FAIL_ON_WARNINGS
# Document what profiling builds compile: core/profile.hpp's other branch only stubs the macros.
PREDEFINED            = TRACY_ENABLE

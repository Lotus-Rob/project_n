CompileFlags:
  CompilationDatabase: build
  Add:
    - -ferror-limit=0
    - -std=c++23
    - -Wall
    - -Wextra
    - -Werror
    - -Wpedantic
    - -Wno-c99-designator
    - -Isrc/
    - -Wno-unknown-warning-option
Diagnostics:
  UnusedIncludes: Strict
---
# clangd analyses an open header as the file being compiled, so -Wunused-macros flags macros
# meant for the files that include it. Real builds and lint never compile a header on its own.
If:
  PathMatch: .*\.hpp
CompileFlags:
  Add: [-Wno-unused-macros]

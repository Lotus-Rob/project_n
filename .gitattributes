# LF everywhere, including Windows checkouts: shell scripts and hooks must keep LF to run.
* text=auto eol=lf
# cmd.exe misparses LF-only batch files (labels, long lines).
*.cmd text eol=crlf
*.png binary
*.jpg binary
# Compiled shaders: hashed byte for byte (shaders/bin/sources.sha256).
*.spv binary
*.dxil binary
# Large binary assets in Git LFS (design doc 0001.1), through the filters `project_n setup` configures.
*.otf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
tests/reference/*.png filter=lfs diff=lfs merge=lfs -text

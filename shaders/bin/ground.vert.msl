#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_ConstantBuffer_GroundPlace
{
    float4 worldToClip;
    float4 quad;
};

struct VertexMain_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

vertex VertexMain_out VertexMain(constant type_ConstantBuffer_GroundPlace& place [[buffer(0)]], uint gl_VertexIndex [[vertex_id]])
{
    VertexMain_out out = {};
    float2 _36 = mix(place.quad.xy, place.quad.zw, float2(float(gl_VertexIndex & 1u), float(gl_VertexIndex >> 1u)));
    out.gl_Position = float4((_36 * place.worldToClip.xy) + place.worldToClip.zw, 0.0, 1.0);
    out.out_var_TEXCOORD0 = _36;
    return out;
}


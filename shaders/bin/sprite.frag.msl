#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FragmentMain_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct FragmentMain_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment FragmentMain_out FragmentMain(FragmentMain_in in [[stage_in]], texture2d<float> atlas [[texture(0)]], sampler atlasSmplr [[sampler(0)]])
{
    FragmentMain_out out = {};
    out.out_var_SV_Target0 = atlas.sample(atlasSmplr, in.in_var_TEXCOORD0);
    return out;
}


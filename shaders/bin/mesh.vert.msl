#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_ConstantBuffer_Draw
{
    float4 pixelsToClip;
};

struct VertexMain_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct VertexMain_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
    float4 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex VertexMain_out VertexMain(VertexMain_in in [[stage_in]], constant type_ConstantBuffer_Draw& draw [[buffer(0)]])
{
    VertexMain_out out = {};
    out.gl_Position = float4((in.in_var_TEXCOORD0 * draw.pixelsToClip.xy) + draw.pixelsToClip.zw, 0.0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    return out;
}


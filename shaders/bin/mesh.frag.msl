#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FragmentMain_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct FragmentMain_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment FragmentMain_out FragmentMain(FragmentMain_in in [[stage_in]], texture2d<float> page [[texture(0)]], sampler pageSmplr [[sampler(0)]])
{
    FragmentMain_out out = {};
    out.out_var_SV_Target0 = in.in_var_TEXCOORD1 * page.sample(pageSmplr, in.in_var_TEXCOORD0).x;
    return out;
}


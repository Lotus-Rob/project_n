#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FragmentMain_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct FragmentMain_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment FragmentMain_out FragmentMain(FragmentMain_in in [[stage_in]])
{
    FragmentMain_out out = {};
    float _21 = 1.0 - in.in_var_TEXCOORD0.x;
    out.out_var_SV_Target0 = (in.in_var_TEXCOORD1 * (_21 * _21)) * smoothstep(0.0, 1.0, 1.0 - abs((in.in_var_TEXCOORD0.y * 2.0) - 1.0));
    return out;
}

